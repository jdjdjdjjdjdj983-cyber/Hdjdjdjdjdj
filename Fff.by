# ============ Полноценный скрипт для подключения к голосовому каналу (discord.py-self) ============
# Использует библиотеку discord.py-self для обработки Gateway, UDP-хендшейка и DTLS-SRTP.
# Требует: Python 3.8+, PyNaCl, discord.py-self
# Установка: pip install discord.py-self PyNaCl

import discord
import asyncio

# ============ 1) Данные ============
TOKEN = "MTU3MjUyODc4MjU1MDUwMzQ2NA.GAn_PX.hoCzXAycD0kJ2s5oBJ57ptPVLgd9Gew3MccM5E"
GUILD_ID = 1539843105073668149
CHANNEL_ID = 1554517929310290012

class VoiceClient(discord.Client):
    async def on_ready(self):
        print(f"[+] Авторизация успешна: {self.user.name}#{self.user.discriminator}")
        print(f"[*] Попытка подключения к каналу...")

        # Поиск сервера и канала
        guild = self.get_guild(GUILD_ID)
        if not guild:
            print("[-] Ошибка: Сервер не найден (проверьте GUILD_ID и наличие аккаунта на сервере).")
            return

        channel = guild.get_channel(CHANNEL_ID)
        if not channel:
            print("[-] Ошибка: Канал не найден (проверьте CHANNEL_ID).")
            return

        try:
            # Подключение к голосовому каналу (в режиме mute и deaf)
            # Библиотека автоматически обрабатывает Opcode 4, Voice Server Update, UDP Handshake и DTLS.
            voice_client = await channel.connect(self_mute=True, self_deaf=True)
            print(f"[+] Успех! Бот подключен к каналу: {channel.name}")
            print(f"[*] Статус: 24/7. Нажмите Ctrl+C для выхода.")
            
            # Бесконечное удержание (библиотека сама отправляет Heartbeat)
            while voice_client.is_connected():
                await asyncio.sleep(10)
                
        except discord.errors.ClientException as e:
            print(f"[-] Ошибка клиента (возможно, уже подключен): {e}")
        except Exception as e:
            print(f"[-] Неизвестная ошибка: {e}")

if __name__ == "__main__":
    # Отключение предупреждений
    import logging
    logging.basicConfig(level=logging.ERROR)
    
    client = VoiceClient()
    try:
        client.run(TOKEN)
    except discord.errors.LoginFailure:
        print("[-] Ошибка: Неверный токен.")
    except KeyboardInterrupt:
        print("[-] Завершение работы.")
